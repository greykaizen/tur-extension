{
  "manifest_version": 2,
  "name": "TUR Download Manager Interceptor",
  "version": "0.1.0",
  "description": "Seamlessly intercepts media streams and downloads, sending them directly to TUR Download Manager.",
  "permissions": [
    "contextMenus",
    "webRequest",
    "webRequestBlocking",
    "nativeMessaging",
    "storage",
    "windows",
    "scripting",
    "activeTab",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["scripts/background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Download with Tur",
    "default_icon": {
      "32": "icons/32x32.png",
      "64": "icons/64x64.png",
      "128": "icons/128x128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/classifier.js", "scripts/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/inject.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "32": "icons/32x32.png",
    "64": "icons/64x64.png",
    "128": "icons/128x128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tur@project.local",
      "strict_min_version": "78.0"
    }
  }
}
